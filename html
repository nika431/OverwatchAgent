          risk: "Review",
          path: "/home/zura156/.cache/BraveSoftware",
          size: "202.8 MB",
          share: 10,
        },
        {
          name: "Firefox browser cache",
          risk: "Review",
          path: "/home/zura156/.cache/mozilla",
          size: "186.4 MB",
          share: 10,
        },
        {
          name: "Pacman package cache",
          risk: "Safe",
          path: "/var/cache/pacman/pkg • keep last 2",
          size: "16.20 GB",
          share: 100,
        },
        {
          name: "node_modules (6 projects)",
          risk: "Review",
          path: "~/projects/*/node_modules",
          size: "3.40 GB",
          share: 30,
        },
        {
          name: "systemd journal (> 2 weeks)",
          risk: "Safe",
          path: "/var/log/journal",
          size: "1.10 GB",
          share: 15,
        },
        {
          name: "Temporary files",
          risk: "Safe",
          path: "/tmp",
          size: "18.4 MB",
          share: 2,
        },
        {
          name: "Flatpak app data",
          risk: "Careful",
          path: "/home/zura156/.var/app",
          size: "4.1 MB",
          share: 1,
        },
      ];

      const RISK_TAG = {
        Safe: "tag-ok",
        Review: "tag-warn",
        Careful: "tag-danger",
      };

      // Used when the backend is unreachable. `color` is a Tailwind background class.
      const FALLBACK_PROCESSES = [
        {
          pid: "",
          name: "> brave x 7",
          mem: "2189.4 MB",
          color: "bg-warnOrange",
        },
        {
          pid: "",
          name: "> Code x 3",
          mem: "1822.8 MB",
          color: "bg-accentBlue",
        },
        {
          pid: "522682",
          name: "SystemMind",
          mem: "764.9 MB",
          color: "bg-textMuted",
        },
        {
          pid: "210750",
          name: "copilot-runtime",
          mem: "464.5 MB",
          color: "bg-accentBlue",
        },
        {
          pid: "107901",
          name: "Discord",
          mem: "300.7 MB",
          color: "bg-alertRed",
        },
      ];

      /* Assistant panel: one question and answer per screen */
      const strong = (text, tone = "text-white") =>
        `<span class="font-semibold ${tone}">${text}</span>`;
      const code = (text) =>
        `<code class="mx-1 rounded border border-borderLine bg-panelBase px-1 py-0.5 text-xs">${text}</code>`;

      const ASSISTANT = {
        dashboard: {
          question: "Anything I should worry about?",
          answer: `${strong("One thing.")} sda1 logged 9 I/O errors this month while the disk is only 17% full. That points to the drive or cable, not space. Back up, then run ${code("smartctl -a /dev/sda")}<br><br>Memory (72%) and battery (32%) are fine for now.`,
        },
        processes: {
          question: "What is using my memory?",
          answer: `${strong("Browsers and editors.")} Brave (11 processes) and VS Code together hold ~2.5 GB, Firefox ~1.5 GB. Closing unused Brave tabs frees the most. SystemMind itself uses 765 MB.`,
        },
        health: {
          question: "What is wrong with my system?",
          answer: `${strong("1. Storage errors (9).")} sda1 I/O errors are the serious ones.<br><br>${strong("2. Hardware errors (16).")} Check whether they cluster with GPU timeouts.<br><br>Spotify crashes (13) are annoying but harmless.`,
        },
        storage: {
          question: "What can I free up?",
          answer: `${strong("Pacman cache is the easy win.")} .zst files hold 19.8 GB (19%). Keeping the last 2 versions frees most of it:<br><br>${code("paccache -rk2")}<br><br>Next: two 1 GB game DLC archives and 7 ollama-rocm copies at ~980 MB each.`,
        },
        cleanup: {
          question: "Is it safe to delete these?",
          answer: `Everything marked Safe is regenerated automatically. ${strong("Review")} items may log you out of sites. ${strong("Careful", "text-alertRed")} items are deleted for good, so keep those unchecked unless sure.`,
        },
        // settings has no entry: the assistant panel just shows the screen name
      };

      /* ==========================================================================
         HELPERS
         ========================================================================== */

      // Anything that can come from the backend must go through esc() before innerHTML.
      const ESC_MAP = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      };
      const esc = (value) =>
        String(value ?? "").replace(/[&<>"']/g, (c) => ESC_MAP[c]);

      const mount = (id, items, renderItem) => {
        document.getElementById(id).innerHTML = items.map(renderItem).join("");
      };

      /* ==========================================================================
         RENDERERS
         ========================================================================== */

      const renderInsight = (i) => `
        <li class="flex cursor-pointer items-center p-3 hover:bg-rowHover">
          <span class="tag tag-${i.tone} mr-4 w-14 text-center">${esc(i.tag)}</span>
          <span class="w-64 font-medium text-white">${esc(i.title)}</span>
          <span class="flex-1 text-sm text-textMuted">${esc(i.detail)}</span>
          <span class="text-textMuted" aria-hidden="true">&rsaquo;</span>
        </li>`;

      // The ring path has a length of ~100, so stroke-dasharray "N 100" fills N percent.
      const GAUGE_PATH =
        "M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831";

      const renderGauge = (g) => `
        <div class="card relative flex flex-col items-center p-4">
          <div class="absolute left-4 top-4 text-xs text-textMuted">${esc(g.label)}</div>
          <div class="relative mt-4 h-28 w-28">
            <svg class="h-full w-full" viewBox="0 0 36 36" role="img" aria-label="${esc(g.label)} ${esc(g.text)}">
              <path class="stroke-borderLine" fill="none" stroke-width="3" d="${GAUGE_PATH}" />
              <path class="gauge-arc ${g.stroke}" fill="none" stroke-width="3" stroke-dasharray="0 100" data-value="${g.value}" d="${GAUGE_PATH}" />
            </svg>
            <div class="absolute inset-0 flex items-center justify-center text-2xl font-bold text-white">${esc(g.text)}</div>
          </div>
          <div class="mt-4 text-center text-xs text-textMuted">${g.caption.map(esc).join("<br />")}</div>
        </div>`;

      // Start every arc at 0, then let the CSS transition fill it to its value.
      const animateGauges = () => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            document.querySelectorAll(".gauge-arc").forEach((arc) => {
              arc.setAttribute("stroke-dasharray", `${arc.dataset.value} 100`);
            });
          });
        });
      };

      const renderHealthStat = (s) => `
        <div class="rounded border p-4 ${s.box}">
          <div class="mb-1 text-xs text-textMuted">${esc(s.label)}</div>
          <div class="text-2xl font-bold ${s.text}">${esc(s.value)}</div>
        </div>`;

      const renderBreadcrumb = (name) =>
        `<button type="button" class="rounded px-2 py-0.5 text-textMuted hover:text-white">${esc(name)}</button>`;

      const renderDrive = (d) => `
        <div class="card p-3">
          <div class="mb-2 flex items-center justify-between">
            <span class="font-medium text-white">${esc(d.name)}</span>
            <span class="text-xs text-textMuted">${esc(d.free)}</span>
          </div>
          <div class="h-1.5 w-full overflow-hidden rounded bg-bgBase">
            <div class="h-full bg-okGreen" style="width: ${d.share}%"></div>
          </div>
        </div>`;

      const renderFolder = (f) => `
        <div class="group flex cursor-pointer items-center justify-between rounded p-2 hover:bg-rowHover">
          <span class="flex gap-2 text-textMuted group-hover:text-white"><span aria-hidden="true">&rsaquo;</span>${esc(f.name)}</span>
          <div class="flex items-center gap-4">
            <div class="h-1.5 w-24 rounded bg-bgBase"><div class="h-full bg-accentBlue" style="width: ${f.share}%"></div></div>
            <span class="w-14 text-right text-xs text-white">${esc(f.size)}</span>
          </div>
        </div>`;

      const renderFileType = (t) => `
        <div class="flex cursor-pointer items-center justify-between rounded p-2 hover:bg-rowHover">
          <div class="flex w-32 shrink-0 items-center gap-3">
            <span class="h-3 w-3 rounded-sm ${t.color}"></span>
            <span class="text-white">${esc(t.ext)}</span>
          </div>
          <span class="min-w-0 flex-1 truncate text-xs text-textMuted" title="${esc(t.kind)}">${esc(t.kind)}</span>
          <span class="w-16 shrink-0 text-right text-xs text-white">${esc(t.size)}</span>
          <span class="w-10 shrink-0 text-right text-xs text-textMuted">${esc(t.share)}</span>
        </div>`;

      const renderTreemapTile = (t) => {
        const width = t.pct ? `width: ${t.pct}%` : "";
        return `
          <button type="button" title="${esc(t.name)}${t.size ? " • " + esc(t.size) : ""}"
            class="flex min-w-0 cursor-pointer flex-col justify-end overflow-hidden rounded-sm p-1 text-left opacity-80 ${t.color} ${t.pct ? "" : "flex-1"} ${t.selected ? "border-2 border-white" : ""}"
            style="${width}">
            ${esc(t.name)}${t.size ? `<span class="text-xxs opacity-60">${esc(t.size)}</span>` : ""}
          </button>`;
      };

      const renderCleanupItem = (c, index) => {
        const isBig = c.size.endsWith("GB");
        return `
          <li class="flex items-center px-4 py-3 hover:bg-rowHover">
            <input type="checkbox" id="clean-${index}" class="mr-4 h-4 w-4 accent-accentBlue" aria-label="Select ${esc(c.name)}" />
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <span class="font-medium text-white">${esc(c.name)}</span>
                <span class="tag ${RISK_TAG[c.risk]} text-xxs uppercase">${esc(c.risk)}</span>
              </div>
              <div class="mt-0.5 font-mono text-xs text-textMuted">${esc(c.path)}</div>
            </div>
            <div class="flex items-center gap-4">
              <span class="w-20 text-right text-sm ${isBig ? "font-medium text-okGreen" : "text-textMuted"}">${esc(c.size)}</span>
              <div class="h-1 w-8 overflow-hidden rounded bg-bgBase"><div class="h-full bg-okGreen" style="width: ${c.share}%"></div></div>
              <button type="button" class="btn-link">Ask assistant</button>
            </div>
          </li>`;
      };

      /* ---- processes: live from the backend, mock data if it is down ---- */

      const PROCESSES_URL = "/api/processes";
      const MAX_MEM_MB = 2500; // memory that fills a bar completely

      const renderProcess = (p) => {
        const color = p.color || "bg-textMuted";
        const width = Math.min(
          100,
          ((parseFloat(p.mem) || 0) / MAX_MEM_MB) * 100,
        );
        return `
          <div class="group flex cursor-pointer items-center border-b border-borderLine px-4 py-2.5 text-sm hover:bg-rowHover">
            <div class="w-20 font-mono text-xs text-textMuted">${esc(p.pid)}</div>
            <div class="flex flex-1 items-center gap-2">
              <span class="h-2 w-2 ${esc(color)}"></span>
              <span class="text-white group-hover:text-accentBlue">${esc(p.name)}</span>
            </div>
            <div class="flex w-48 items-center justify-end gap-3">
              <span class="w-20 text-right text-textMuted">${esc(p.mem)}</span>
              <div class="flex h-1.5 w-24 overflow-hidden rounded bg-bgBase">
                <div class="h-full ${esc(color)}" style="width: ${width}%"></div>
              </div>
            </div>
          </div>`;
      };

      function renderProcesses(processes) {
        const header = `
          <div class="sticky top-0 flex border-b border-borderLine bg-panelBase px-4 py-2 text-xs text-textMuted">
            <div class="w-20">PID</div>
            <div class="flex-1">PROCESS</div>
            <div class="w-48 text-right">MEMORY &darr;</div>
          </div>`;
        document.getElementById("process-list").innerHTML =
          header + processes.map(renderProcess).join("");
      }

      async function loadProcesses() {
        try {
          const response = await fetch(PROCESSES_URL, {
            signal: AbortSignal.timeout(3000),
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const data = await response.json();
          if (!Array.isArray(data))
            throw new Error("expected an array of processes");
          renderProcesses(data);
        } catch (error) {
          console.warn(
            "Process API unavailable, using mock data:",
            error.message,
          );
          renderProcesses(FALLBACK_PROCESSES);
        }
      }

      /* ==========================================================================
         NAVIGATION AND ASSISTANT PANEL
         ========================================================================== */

      const views = document.querySelectorAll(".view");
      const navButtons = document.querySelectorAll(".nav-btn");
      const assistant = {
        context: document.getElementById("assistant-context"),
        question: document.getElementById("assistant-question"),
        response: document.getElementById("assistant-response"),
      };

      function updateAssistant(tabId) {
        const entry = ASSISTANT[tabId];
        assistant.context.textContent = tabId.toUpperCase();
        assistant.question.hidden = !entry;
        assistant.response.hidden = !entry;
        if (entry) {
          assistant.question.textContent = entry.question;
          assistant.response.innerHTML = entry.answer;
        }
      }

      function switchTab(tabId) {
        if (!document.getElementById(`view-${tabId}`)) return;

        views.forEach((view) =>
          view.classList.toggle("active", view.id === `view-${tabId}`),
        );
        navButtons.forEach((btn) => {
          if (btn.dataset.tab === tabId)
            btn.setAttribute("aria-current", "page");
          else btn.removeAttribute("aria-current");
        });
        updateAssistant(tabId);
      }

      document.querySelector("nav").addEventListener("click", (event) => {
        const btn = event.target.closest("[data-tab]");
        if (btn) switchTab(btn.dataset.tab);
      });

      /* ==========================================================================
         START
         ========================================================================== */

      mount("insights", INSIGHTS, renderInsight);
      mount("gauges", GAUGES, renderGauge);
      mount("health-stats", HEALTH_STATS, renderHealthStat);
      mount("folders", FOLDERS, renderFolder);
      mount("file-types", FILE_TYPES, renderFileType);
      mount("treemap", TREEMAP, renderTreemapTile);
      mount("cleanup-list", CLEANUP_ITEMS, renderCleanupItem);
      document.querySelector("#breadcrumbs .card").innerHTML =
        BREADCRUMBS.map(renderBreadcrumb).join("");
      document
        .getElementById("drive-stats")
        .insertAdjacentHTML("afterbegin", DRIVES.map(renderDrive).join(""));

      animateGauges();
      switchTab("dashboard");
      loadProcesses();
    </script>
  </body>
</html>
