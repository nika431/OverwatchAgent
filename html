<!DOCTYPE html>
<html lang="en" style="color-scheme: dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SystemMind UI</title>

    <!-- Tailwind Play CDN (development build). Pinned so a CDN update cannot change the look
         mid-hackathon. For production, compile the CSS with the Tailwind CLI instead. -->
    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              bgBase: "#0d1117", // app background
              bgDeep: "#0a0c10", // main area, inputs
              panelBase: "#161b22", // cards, panels
              rowHover: "#1f242c", // list row hover
              borderLine: "#30363d",
              textMain: "#c9d1d9",
              textMuted: "#8b949e",
              accentBlue: "#2f81f7",
              accentPurple: "#a371f7",
              alertRed: "#f85149",
              warnOrange: "#d29922",
              okGreen: "#2ea043",
            },
            fontSize: { xxs: "0.65rem" },
          },
        },
      };
    </script>

    <!-- Reusable components (Tailwind @apply) so the markup below stays readable -->
    <style type="text/tailwindcss">
      @layer components {
        /* buttons */
        .btn {
          @apply whitespace-nowrap rounded border border-borderLine px-3 py-1.5 text-sm hover:bg-borderLine;
        }
        .btn-primary {
          @apply whitespace-nowrap rounded-md bg-accentBlue px-4 py-1.5 text-sm font-medium text-white transition-colors hover:bg-blue-600;
        }
        .btn-danger {
          @apply whitespace-nowrap rounded border border-alertRed/30 bg-alertRed/10 px-3 py-1.5 text-sm text-alertRed hover:bg-alertRed/20;
        }
        .btn-link {
          @apply text-sm text-textMuted hover:text-white;
        }
        .chip {
          @apply whitespace-nowrap rounded border border-borderLine px-3 py-1 text-xs text-textMuted transition hover:bg-borderLine hover:text-white;
        }

        /* surfaces and text */
        .card {
          @apply rounded-md border border-borderLine bg-panelBase;
        }
        .eyebrow {
          @apply text-xs uppercase tracking-widest text-textMuted;
        }
        .page-head {
          @apply flex items-end justify-between;
        }
        .page-title {
          @apply text-2xl font-bold text-white;
        }
        .page-sub {
          @apply mt-1 text-xs text-textMuted;
        }
        .field {
          @apply rounded border border-borderLine bg-bgDeep px-3 py-1.5 text-sm outline-none focus:border-accentBlue;
        }

        /* status tags and count badges */
        .tag {
          @apply rounded border px-1.5 text-xs;
        }
        .tag-ok {
          @apply border-okGreen text-okGreen;
        }
        .tag-warn {
          @apply border-warnOrange text-warnOrange;
        }
        .tag-danger {
          @apply border-alertRed text-alertRed;
        }
        .badge {
          @apply rounded border border-borderLine bg-borderLine px-1.5 text-xs text-textMuted;
        }
        .badge-danger {
          @apply border-alertRed/30 text-alertRed;
        }

        /* sidebar navigation: the active state comes from aria-current, not from toggled classes */
        .nav-group {
          @apply px-2 text-xxs font-bold tracking-wider text-textMuted;
        }
        .nav-btn {
          @apply flex w-full items-center justify-between rounded-md border border-transparent px-2 py-1.5 text-left text-textMuted hover:bg-panelBase hover:text-white aria-[current=page]:border-borderLine aria-[current=page]:bg-panelBase aria-[current=page]:text-white;
        }

        /* one screen of the app; .active shows it */
        .view {
          @apply hidden min-h-0 flex-1 flex-col overflow-y-auto p-6;
        }
        .view.active {
          @apply flex;
        }
      }
    </style>

    <style>
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
      }

      /* scrollbars */
      :root {
        --scroll-thumb: #30363d;
        --scroll-thumb-hover: #484f58;
      }
      * {
        scrollbar-width: thin;
        scrollbar-color: var(--scroll-thumb) transparent;
      }
      ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      ::-webkit-scrollbar-track {
        background: transparent;
      }
      ::-webkit-scrollbar-thumb {
        background: var(--scroll-thumb);
        border-radius: 3px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--scroll-thumb-hover);
      }
      .no-scrollbar {
        scrollbar-width: none;
      }
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }

      /* circular gauge arcs animate to their value */
      .gauge-arc {
        transition: stroke-dasharray 0.8s ease-out;
      }
      @media (prefers-reduced-motion: reduce) {
        .gauge-arc {
          transition: none;
        }
      }
    </style>
  </head>

  <body class="flex h-screen overflow-hidden bg-bgBase text-sm text-textMain">
    <!-- LEFT SIDEBAR -->
    <aside
      class="z-10 flex w-60 shrink-0 flex-col border-r border-borderLine bg-bgBase"
    >
      <div class="flex h-14 items-center gap-2 px-4 font-semibold text-white">
        <svg
          class="h-5 w-5 text-accentBlue"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
        </svg>
        SystemMind
      </div>

      <nav
        class="flex flex-1 flex-col gap-1 overflow-y-auto px-2 py-2"
        aria-label="Main"
      >
        <div class="nav-group mb-1 mt-4">MONITORING</div>
        <button
          type="button"
          class="nav-btn"
          data-tab="dashboard"
          aria-current="page"
        >
          Dashboard
        </button>
        <button type="button" class="nav-btn" data-tab="storage">
          Storage
        </button>
        <button type="button" class="nav-btn" data-tab="processes">
          Processes
        </button>
        <button type="button" class="nav-btn" data-tab="health">
          System Health
          <span class="badge badge-danger">22</span>
        </button>

        <div class="nav-group mb-1 mt-6">TOOLS</div>
        <button type="button" class="nav-btn" data-tab="cleanup">
          Cleanup
          <span class="badge">401 MB</span>
        </button>
        <button type="button" class="nav-btn" data-tab="settings">
          Settings
        </button>
      </nav>

      <div class="border-t border-borderLine p-4">
        <div class="mb-1 text-xxs tracking-wider text-textMuted">
          SYSTEM HEALTH • LIVE
        </div>
        <div class="mb-4 flex items-end justify-between">
          <div class="text-3xl font-bold leading-none text-white">92</div>
          <span class="tag tag-warn py-0.5">WATCH</span>
        </div>
        <div class="text-xs leading-tight text-textMuted">
          zenbook • Arch Linux<br />Sampled every 2 s
        </div>
      </div>
    </aside>

    <!-- MAIN CONTENT AREA -->
    <main class="flex min-w-0 flex-1 flex-col bg-bgDeep">
      <header
        class="flex h-14 shrink-0 items-center justify-between border-b border-borderLine px-6"
      >
        <div class="font-mono text-xs uppercase tracking-widest text-textMuted">
          SUN 18 OCT • 16 LOGICAL CORES • <span class="text-okGreen">LIVE</span>
        </div>
        <button type="button" class="btn-primary">
          Explain my system &rarr;
        </button>
      </header>

      <!-- DASHBOARD -->
      <section
        id="view-dashboard"
        class="view active gap-4"
        aria-label="Dashboard"
      >
        <div class="mb-2 border-l-2 border-warnOrange pl-4">
          <div class="eyebrow mb-1">Insights</div>
          <h2 class="mb-4 text-xl font-semibold text-white">
            Running fine. One thing needs a look: disk errors.
          </h2>
          <ul
            id="insights"
            class="card divide-y divide-borderLine overflow-hidden"
          ></ul>
        </div>
        <div id="gauges" class="mt-2 grid grid-cols-4 gap-4"></div>
      </section>

      <!-- STORAGE -->
      <section id="view-storage" class="view gap-4" aria-label="Storage">
        <div class="mb-2 flex flex-wrap items-center justify-between gap-3">
          <div id="breadcrumbs" class="flex items-center gap-1">
            <span class="px-2 text-lg text-textMuted">/</span>
            <div class="card flex gap-1 px-1 py-0.5"></div>
          </div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <span class="text-xs text-textMuted"
              >Scan completed in 7.4 s • 723,352 files • 104.14 GB</span
            >
            <div class="flex gap-2">
              <button type="button" class="btn">Browse...</button>
              <button type="button" class="btn-primary">Scan</button>
              <button type="button" class="btn text-textMuted">Cancel</button>
            </div>
          </div>
        </div>

        <div id="drive-stats" class="grid grid-cols-3 gap-4">
          <div
            class="flex flex-col justify-center rounded-md border border-accentBlue/30 bg-accentBlue/5 p-3"
          >
            <div class="flex items-start justify-between gap-3">
              <span class="text-sm font-medium text-white">Tip</span>
              <span class="text-xs text-textMuted"
                >pacman cache = 19% of scan</span
              >
            </div>
            <span class="mt-1 text-xs text-textMuted"
              >Keep last 2 versions to free ~16 GB</span
            >
          </div>
        </div>

        <!-- grid-rows + min-h-0 keep both panels inside the row; their lists scroll instead of spilling out -->
        <div
          class="grid min-h-[250px] flex-1 grid-cols-2 grid-rows-[minmax(0,1fr)] gap-4"
        >
          <div class="card flex min-h-0 flex-col">
            <div class="eyebrow border-b border-borderLine p-4">
              FOLDERS • SIZE SHARE
            </div>
            <div id="folders" class="min-h-0 flex-1 overflow-y-auto p-2"></div>
          </div>
          <div class="card flex min-h-0 flex-col">
            <div class="eyebrow border-b border-borderLine p-4">FILE TYPES</div>
            <div
              id="file-types"
              class="min-h-0 flex-1 overflow-y-auto p-2"
            ></div>
          </div>
        </div>

        <!-- Treemap preview -->
        <div
          id="treemap"
          class="flex h-24 gap-1 text-xs font-medium leading-tight text-black"
        ></div>

        <div
          class="flex flex-wrap items-center justify-between gap-2 border-t border-borderLine pt-2"
        >
          <div class="text-xs text-textMuted">
            Selected: <span class="text-white">cuda-13.4.2-1-x86...</span> •
            2.43 GB
          </div>
          <div class="flex flex-wrap gap-2">
            <button type="button" class="btn">Reveal</button>
            <button type="button" class="btn">Terminal</button>
            <button type="button" class="btn">Copy path</button>
            <button type="button" class="btn text-white">Ask assistant</button>
            <button type="button" class="btn-danger">Move to trash</button>
          </div>
        </div>
      </section>

      <!-- PROCESSES -->
      <section id="view-processes" class="view" aria-label="Processes">
        <div class="page-head mb-6">
          <div>
            <h1 class="page-title">Processes</h1>
            <p class="page-sub">
              Tracking 458 active processes • 16 cores • grouped ones share a
              name
            </p>
          </div>
          <button type="button" class="btn text-white">Refresh</button>
        </div>

        <div
          class="flex items-center gap-4 rounded-t-md border border-borderLine bg-panelBase p-3"
        >
          <div class="w-24 border-r border-borderLine text-center">
            <div class="font-bold text-accentBlue">70%</div>
            <div class="text-xs text-textMuted">CPU</div>
          </div>
          <div class="w-24 border-r border-borderLine text-center">
            <div class="font-bold text-warnOrange">10.9 / 14.7<br />GB</div>
            <div class="text-xs text-textMuted">RAM</div>
          </div>
          <input
            type="text"
            class="field min-w-0 flex-1"
            placeholder="Filter by name or PID..."
            aria-label="Filter processes"
          />
          <div class="flex gap-2">
            <button
              type="button"
              class="rounded bg-borderLine px-3 py-1.5 text-sm text-white"
            >
              App
            </button>
            <button
              type="button"
              class="rounded px-3 py-1.5 text-sm text-textMuted hover:bg-borderLine"
            >
              Process
            </button>
          </div>
          <button type="button" class="btn">Ask assistant</button>
          <button type="button" class="btn-danger">End task</button>
        </div>

        <div
          id="process-list"
          class="flex-1 overflow-y-auto rounded-b-md border-x border-b border-borderLine bg-panelBase"
        ></div>
      </section>

      <!-- SYSTEM HEALTH -->
      <section id="view-health" class="view" aria-label="System health">
        <div class="page-head mb-6">
          <div>
            <h1 class="page-title">System Health</h1>
            <p class="page-sub">
              Crashes, hardware, driver and storage events from the Linux system
              journal
            </p>
          </div>
          <div class="card flex gap-2 p-1">
            <button type="button" class="px-3 py-1 text-xs text-textMuted">
              7D
            </button>
            <button
              type="button"
              class="rounded bg-borderLine px-3 py-1 text-xs text-white"
              aria-pressed="true"
            >
              30D
            </button>
            <button type="button" class="px-3 py-1 text-xs text-textMuted">
              90D
            </button>
            <button
              type="button"
              class="ml-2 whitespace-nowrap rounded bg-accentBlue px-4 py-1 text-xs text-white"
            >
              Scan now
            </button>
          </div>
        </div>
        <div id="health-stats" class="mb-6 grid grid-cols-3 gap-4"></div>
      </section>

      <!-- CLEANUP -->
      <section id="view-cleanup" class="view gap-4" aria-label="Cleanup">
        <div class="page-head mb-4">
          <div>
            <h1 class="page-title">Cleanup</h1>
            <p class="page-sub">
              Caches, packages and build artifacts you can safely reclaim
            </p>
          </div>
          <div class="flex gap-2">
            <button type="button" class="btn px-4 text-white">Scan</button>
            <button
              type="button"
              class="cursor-not-allowed rounded border border-accentBlue/30 bg-accentBlue/20 px-4 py-1.5 text-sm text-accentBlue opacity-50"
              disabled
            >
              Move to trash
            </button>
          </div>
        </div>

        <div class="card mb-2 grid grid-cols-3 gap-4 p-4">
          <div class="border-r border-borderLine">
            <div class="mb-1 text-xs text-textMuted">DETECTED</div>
            <div class="text-2xl font-bold text-accentBlue">21.10 GB</div>
            <div class="text-xs text-textMuted">7 targets</div>
          </div>
          <div class="border-r border-borderLine px-4">
            <div class="mb-1 text-xs text-textMuted">SELECTED</div>
            <div class="text-2xl font-bold text-white">0.0 MB</div>
            <div class="text-xs text-textMuted">
              0 items • moved to trash, undo for 10 min
            </div>
          </div>
          <div class="px-4">
            <div class="mb-1 text-xs text-textMuted">LAST CLEAN</div>
            <div class="text-sm font-medium text-white">
              Reclaimed 1.96 GB across 5 items
            </div>
            <div class="text-xs text-textMuted">Today 02:51</div>
          </div>
        </div>

        <div class="mb-2 flex gap-2">
          <button
            type="button"
            class="rounded border border-borderLine px-3 py-1 text-sm text-textMuted hover:text-white"
          >
            Select all Safe
          </button>
          <button
            type="button"
            class="rounded border border-borderLine px-3 py-1 text-sm text-textMuted hover:text-white"
          >
            Deselect all
          </button>
        </div>

        <ul
          id="cleanup-list"
          class="card flex-1 divide-y divide-borderLine overflow-y-auto"
        ></ul>
      </section>

      <!-- SETTINGS (placeholder: the sidebar link used to open a blank screen) -->
      <section id="view-settings" class="view" aria-label="Settings">
        <h1 class="page-title">Settings</h1>
        <p class="page-sub">Nothing to configure yet.</p>
      </section>
    </main>

    <!-- RIGHT SIDEBAR: ASSISTANT -->
    <aside
      class="z-10 flex w-80 shrink-0 flex-col border-l border-borderLine bg-bgBase"
      aria-label="Assistant"
    >
      <div
        class="flex h-14 items-center justify-between border-b border-borderLine px-4"
      >
        <div class="flex gap-2 font-mono text-xs text-textMuted">
          <span>ASSISTANT</span> • <span class="text-okGreen">READY</span>
        </div>
        <button type="button" class="text-xs text-textMuted hover:text-white">
          HISTORY
        </button>
      </div>

      <div
        class="flex flex-1 flex-col gap-4 overflow-y-auto p-4"
        aria-live="polite"
      >
        <div
          id="assistant-context"
          class="self-start rounded border border-borderLine px-2 py-1 text-xs text-textMuted"
        ></div>
        <div
          id="assistant-question"
          class="max-w-[90%] self-end rounded-lg border border-borderLine bg-panelBase p-3 text-sm text-textMain"
        ></div>
        <div
          id="assistant-response"
          class="self-start text-sm leading-relaxed text-textMain"
        ></div>
      </div>

      <div class="border-t border-borderLine bg-panelBase p-4">
        <div class="no-scrollbar mb-2 flex gap-2 overflow-x-auto pb-1">
          <button type="button" class="chip">Check memory</button>
          <button type="button" class="chip">Explain sda1 errors</button>
        </div>
        <div class="flex gap-2">
          <input
            type="text"
            class="field min-w-0 flex-1 bg-bgBase py-2"
            placeholder="Ask about this screen"
            aria-label="Ask the assistant"
          />
          <button
            type="button"
            class="rounded bg-accentBlue px-4 text-sm font-medium text-white hover:bg-blue-600"
          >
            Ask
          </button>
        </div>
        <div class="mt-2 text-center text-xxs text-textMuted">
          openrouter/free • sends summaries, not file contents
        </div>
      </div>
    </aside>

